# Raw dumps and heavy intermediates are rebuilt by `make all`.
/data/raw/
/data/interim/
/data/processed/*
# App-facing artifacts are committed so the deployed app needs no build step.
# (Exclude the *contents* of processed/, not the directory, so this re-include works.)
!/data/processed/app/
# Trained models are rebuilt by `make models`; the two the app loads live
# (~15 MB total) are committed so the deploy needs no training step.
/models/*
!/models/outcome.joblib
!/models/winprob.joblib
!/models/outcome_metrics.json
!/models/winprob_metrics.json

*.pyc
__pycache__/
.ipynb_checkpoints/
.venv/
venv/
.pytest_cache/
reports/figures/*.png
.DS_Store

*.egg-info/
